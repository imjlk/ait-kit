    "@ait-kit/api-orpc": "0.4.2",
    "@orpc/server": "1.15.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260915.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.131.2"
  }
}
