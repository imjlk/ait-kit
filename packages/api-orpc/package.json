{
  "name": "@ait-kit/api-orpc",
  "version": "0.1.1",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun build src/index.ts --outfile dist/index.js --format esm --target browser --packages external",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@ait-kit/api-core": "0.1.1",
    "@orpc/server": "1.14.6",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
