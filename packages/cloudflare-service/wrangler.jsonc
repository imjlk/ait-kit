{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ait-kit-toss-api-service",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-09",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "TOSS_API_MODE": "stub",
    "TOSS_API_BASE_URL": "https://apps-in-toss-api.toss.im"
  }
}
