{
  "name": "@ait-kit/api-cloudflare-service",
  "version": "0.1.2",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/imjlk/ait-kit"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun build src/index.ts --outfile dist/index.js --format esm --target browser --packages external --external cloudflare:workers",
    "prepack": "bun run build",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@ait-kit/api-core": "0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260630.1",
    "typescript": "6.0.3",
    "wrangler": "4.105.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
