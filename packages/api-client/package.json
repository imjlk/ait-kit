{
  "name": "@ait-kit/api-client",
  "version": "0.2.0",
  "description": "Typed HTTP client helpers for Apps in Toss mTLS proxy services.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjlk/ait-kit.git",
    "directory": "packages/api-client"
  },
  "homepage": "https://github.com/imjlk/ait-kit#readme",
  "bugs": {
    "url": "https://github.com/imjlk/ait-kit/issues"
  },
  "keywords": [
    "apps-in-toss",
    "toss",
    "mtls",
    "http-client",
    "typescript"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun build src/index.ts --outfile dist/index.js --format esm --target browser --packages external",
    "test": "bun test test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@ait-kit/api-core": "0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
