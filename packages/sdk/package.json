{
  "name": "@ait-kit/sdk",
  "version": "0.1.0",
  "description": "Frontend SDK adapters for Apps in Toss mini apps: shared contracts plus per-runtime entry points.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjlk/ait-kit.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/imjlk/ait-kit#readme",
  "bugs": {
    "url": "https://github.com/imjlk/ait-kit/issues"
  },
  "keywords": [
    "apps-in-toss",
    "toss",
    "sdk",
    "react-native",
    "ads"
  ],
  "sideEffects": [
    "./src/rn/**"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./rn": {
      "types": "./dist/rn/index.d.ts",
      "import": "./dist/rn/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test test",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "@apps-in-toss/framework": "*"
  },
  "peerDependenciesMeta": {
    "@apps-in-toss/framework": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
