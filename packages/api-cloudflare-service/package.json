{
  "name": "@ait-kit/api-cloudflare-service",
  "version": "0.2.0",
  "description": "Cloudflare WorkerEntrypoint Service Binding provider for typed Apps in Toss server APIs.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjlk/ait-kit.git",
    "directory": "packages/api-cloudflare-service"
  },
  "homepage": "https://github.com/imjlk/ait-kit#readme",
  "bugs": {
    "url": "https://github.com/imjlk/ait-kit/issues"
  },
  "keywords": [
    "apps-in-toss",
    "toss",
    "cloudflare-workers",
    "service-bindings",
    "mtls"
  ],
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun build src/index.ts --outfile dist/index.js --format esm --target browser --packages external --external cloudflare:workers",
    "test": "bun test test",
    "prepack": "bun run build",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@ait-kit/api-core": "0.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260712.1",
    "typescript": "6.0.3",
    "wrangler": "4.110.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
